VITE_URL_DO_RELAY=
VITE_URL_DA_API=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID_DESKTOP=

# Só no npm run dev: com 1, o app abre logado numa conta de teste, sem o Google.
VITE_CONTA_FALSA=

# Com 1, o modo Mania aparece no app. Fica desligado até ele estar pronto.
VITE_MODO_MANIA=

# Só no npm run lancar: chave privada do updater (caminho ou conteúdo; sem ela usa ~/.tauri/riffrush.key) e a senha dela.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
