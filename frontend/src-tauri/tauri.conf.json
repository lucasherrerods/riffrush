{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Riff Rush",
  "version": "0.1.4",
  "identifier": "com.riffrush.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Riff Rush",
        "width": 1280,
        "height": 760,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGN0QxMkRDRTIzREI1RTMKUldUanRUM2kzQko5UCsvYm1QZU5oR3d2TFZ2czI5Y1J3VFdhT1RPREN4S0Zic3FidHRhZWV3c3oK",
      "endpoints": [
        "https://github.com/lucasherrerods/riffrush/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
