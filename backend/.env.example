DATABASE_URL=postgres://riffrush:riffrush@localhost:5432/riffrush
ENDERECO=0.0.0.0:8080
ORIGENS_PERMITIDAS=http://localhost:1420
RUST_LOG=info
# O endereço da API visto de fora, para o endereço das fotos e capas enviadas. Sem ele, usa http://localhost:<porta>.
URL_PUBLICA_DA_API=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Client do tipo "App para computador", para o login no app desktop.
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
# Igual ao segredo do relay (npx wrangler secret put SEGREDO_DA_PRESENCA). Sem ele, a lista de quem está online fica desligada.
SEGREDO_DO_RELAY=
# O mesmo endereço do VITE_URL_DO_RELAY do app (wss://...). Com ele, banir no chat vale na hora para quem já está conectado
# e as mensagens entre amigos chegam na hora (sem ele, aparecem só ao abrir a conversa).
URL_DO_RELAY=

# Obrigatória: cifra o texto das mensagens privadas no banco. 32 bytes em base64 (openssl rand -base64 32).
# Guarde uma cópia: trocar ou perder a chave deixa as mensagens já guardadas ilegíveis.
CHAVE_DAS_MENSAGENS=

# Client da API do osu! para conferir as partidas do Mania (osu.ppy.sh/home/account/edit, seção OAuth).
# Opcionais: sem eles, o servidor busca os mapas no espelho catboy.best.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
